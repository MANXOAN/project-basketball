# Server
PORT=3000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/db_datn_su26
ALLOW_IN_MEMORY_DB=false
DB_DUMP_DIR=

# Authentication
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES=7d

# Gmail SMTP - use a Google App Password, never your normal Gmail password
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=replace_with_google_app_password

# VNPay Sandbox credentials (get these from your VNPay Sandbox merchant account)
VNP_TMN_CODE=your_sandbox_merchant_code
VNP_HASH_SECRET=your_sandbox_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5173/vnpay-return

# Optional news source
VBA_NEWS_API_URL=
# DB local từng máy: true để mỗi lần start nạp cùng Backend/data/db-snapshot.json.
# DB server dùng chung: bắt buộc false để không xóa dữ liệu chung khi một máy restart.
DB_RESET_ON_START=true
